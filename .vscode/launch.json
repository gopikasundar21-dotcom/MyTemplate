{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "APPNAME_ENV": "dev",
                "FLASK_APP": "manage",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "autoStartBrowser": false
        }
    ]
}
